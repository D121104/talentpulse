APP_ENV=local
CHAT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_PROVIDER=sentence_transformers
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_DEVICE=cpu
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=jobs_bge_m3_1024_local_v1
QDRANT_ALIAS=jobs_current_local
AI_SERVICE_AUTH_MODE=jwt
# Set to the development public key; never commit a private key.
AI_SERVICE_AUTH_ISSUER=talentpulse-api
AI_SERVICE_AUTH_AUDIENCE=talentpulse-ai
AI_SERVICE_AUTH_KEY_ID=dev-key-1
AI_SERVICE_AUTH_PUBLIC_KEY=
# Compose mounts the ignored development public key at this path.
AI_SERVICE_AUTH_PUBLIC_KEY_FILE=../.secrets/ai-service-dev-public.pem
# Compose overrides only the key-file path with /run/secrets/ai-service-public-key.

# Phase 1 foundation policy. Fresh local Qdrant volumes may initialize this
# collection and alias; mismatched existing model-space metadata is not ready.
QDRANT_AUTO_INITIALIZE=true
QDRANT_TIMEOUT_SECONDS=3
