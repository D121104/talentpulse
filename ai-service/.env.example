# Non-secret local defaults. scripts/start-local.sh overrides the selected profile at runtime.
AI_ENVIRONMENT=local
AI_AUTH_REQUIRED=false
AI_EMBEDDING_PROVIDER=deterministic
AI_VECTOR_STORE_PROVIDER=memory
AI_GENERATION_PROVIDER=deterministic
AI_COHERE_MODEL=cohere.embed-multilingual-v3
AI_COHERE_DIMENSIONS=1024

# Explicit Ollama/Qdrant profile values; unused by the deterministic default.
AI_OLLAMA_URL=http://127.0.0.1:11435
AI_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_OLLAMA_GENERATION_MODEL=qwen3:1.7b
# Per-provider request timeout; bounded by FastAPI to a maximum of 120 seconds.
AI_OLLAMA_TIMEOUT_SECONDS=120
AI_OLLAMA_EMBEDDING_DIMENSIONS=1024
AI_QDRANT_URL=http://127.0.0.1:6333
AI_QDRANT_COLLECTION=jobs_ollama_1024_local_v1
AI_QDRANT_ALIAS=jobs_current_local
AI_QDRANT_INDEX_VERSION=local-ollama-v1
AI_QDRANT_ADMIN_ENABLED=false

# Host-local PDF OCR is disabled by default. scripts/start-local.sh --cv-ocr
# enables these bounded settings only for its FastAPI child.
AI_CV_OCR_ENABLED=false
AI_CV_OCR_NATIVE_TEXT_MIN_CHARS=250
AI_CV_OCR_MAX_PAGES=5
AI_CV_OCR_DPI=200
AI_CV_OCR_MAX_RENDER_PIXELS=10000000
AI_CV_OCR_RENDER_TIMEOUT_SECONDS=10
AI_CV_OCR_RECOGNIZE_TIMEOUT_SECONDS=15
AI_CV_OCR_TOTAL_TIMEOUT_SECONDS=60
AI_CV_OCR_MAX_STDOUT_BYTES=1000000
# Pydantic Settings-compatible JSON list; only eng and vie are supported locally.
AI_CV_OCR_LANGUAGES=["eng","vie"]
