# Operator/runtime placeholders used for bundle metadata, Compose interpolation,
# and deployment configuration. Runtime secrets are rendered on EC2 from Secrets
# Manager; do not commit a populated copy.
BACKEND_IMAGE=example.invalid/talentpulse/backend@sha256:replace-me
AI_SERVICE_IMAGE=example.invalid/talentpulse/ai-service@sha256:replace-me
AWS_REGION=replace-with-deployment-region
URL_FRONTEND=https://replace-with-cloudfront-domain

# Secret JSON field placeholders documented for the configured Secrets Manager
# contracts. ai-entrypoint.sh reads these from the secret ARNs, not from this file.
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_USERNAME=replace-with-runtime-secret
DB_PASSWORD=replace-with-runtime-secret
DB_DATABASE=talentpulse_demo
REDIS_PASSWORD=replace-with-runtime-secret
JWT_SECRET=replace-with-runtime-secret
JWT_REFRESH_SECRET=replace-with-runtime-secret
AI_SERVICE_ISSUER=replace-with-service-issuer
AI_SERVICE_AUDIENCE=replace-with-service-audience
AI_SERVICE_JWT_ALGORITHM=RS256
AI_SERVICE_JWT_TTL_SECONDS=60
AI_SERVICE_JWT_PRIVATE_KEY=replace-with-runtime-secret
AI_SERVICE_TIMEOUT_MS=10000
AI_JWT_PUBLIC_KEY=replace-with-public-key
AI_QDRANT_URL=https://replace-with-qdrant-endpoint

# Non-secret values rendered by ai-entrypoint.sh into the backend/AI runtime
# env files. AI_BEDROCK_REGION is generated from the deployment region above.
AI_SERVICE_URL=https://ai-service:8000
AI_AUTH_REQUIRED=true
AI_JWT_ALGORITHMS=["RS256"]
AI_JWT_SUBJECT=talentpulse-backend
AI_CV_PARSE_SCOPE=cv:parse
AI_CV_MATCH_SCOPE=cv:match
AI_RAG_RETRIEVE_SCOPE=rag:retrieve
AI_RAG_GENERATE_SCOPE=rag:generate
AI_JOB_INDEX_SCOPE=jobs:index
AI_EMBEDDING_PROVIDER=cohere
AI_VECTOR_STORE_PROVIDER=qdrant
AI_GENERATION_PROVIDER=bedrock
AI_COHERE_MODEL=cohere.embed-multilingual-v3
AI_COHERE_DIMENSIONS=1024
AI_QDRANT_COLLECTION=jobs_cohere_multilingual_v3_1024_demo_v1
AI_QDRANT_ALIAS=jobs_current_demo
AI_QDRANT_INDEX_VERSION=demo-v1
# Operator-only one-shot command; keep disabled for normal service startup.
AI_QDRANT_ADMIN_ENABLED=false
AI_BEDROCK_MODEL=amazon.nova-lite-v1:0
AI_BEDROCK_REGION=replace-with-deployment-region
