# Backend API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000

# WebSocket / Socket.IO URL
VITE_SOCKET_URL=http://localhost:8000

# Application Info
VITE_APP_NAME=TalentPulse
VITE_APP_ENV=development

# Internationalization
VITE_DEFAULT_LANGUAGE=vi
VITE_FALLBACK_LANGUAGE=vi

# Google OAuth is initiated through VITE_API_URL/auth/google.
# Configure GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and GOOGLE_CALLBACK_URL
# only in backend/.env. Do not expose Google secrets through VITE_ variables.
