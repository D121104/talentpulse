{
  "name": "backend2",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed:hr": "ts-node -r tsconfig-paths/register src/scripts/seed-hr.ts",
    "seed:candidate": "ts-node -r tsconfig-paths/register src/scripts/seed-candidate.ts",
    "seed:all": "ts-node -r tsconfig-paths/register src/scripts/seed-hr.ts && ts-node -r tsconfig-paths/register src/scripts/seed-candidate.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.11.2",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^9.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "9.4.0",
    "@nestjs/jwt": "10.0.3",
    "@nestjs/mapped-types": "1.2.1",
    "@nestjs/passport": "9.0.3",
    "@nestjs/platform-express": "^9.4.0",
    "@nestjs/platform-socket.io": "^9.4.3",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^9.0.1",
    "@nestjs/websockets": "^9.4.3",
    "@xenova/transformers": "^2.17.2",
    "api-query-params": "5.4.0",
    "axios": "^1.13.5",
    "bcryptjs": "2.4.3",
    "bull": "^4.12.2",
    "cache-manager": "^4.1.0",
    "cache-manager-redis-store": "^2.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cloudinary": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "crypto": "^1.0.1",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "helmet": "^7.1.0",
    "mammoth": "^1.11.0",
    "ms": "^2.1.3",
    "nodemailer": "^6.9.13",
    "passport": "0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.5",
    "puppeteer": "^24.37.5",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.2.0",
    "serve-static": "^1.15.0",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "9.4.2",
    "@nestjs/schematics": "9.1.0",
    "@nestjs/testing": "9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cache-manager": "^4.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "4.17.13",
    "@types/jest": "29.5.0",
    "@types/ms": "^0.7.34",
    "@types/multer": "^1.4.11",
    "@types/node": "18.15.11",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.4",
    "@types/supertest": "2.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "5.0.0",
    "@typescript-eslint/parser": "5.0.0",
    "eslint": "8.0.1",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "4.0.0",
    "jest": "29.5.0",
    "prettier": "2.3.2",
    "source-map-support": "0.5.21",
    "supertest": "6.1.3",
    "ts-jest": "29.0.5",
    "ts-loader": "9.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}