# Environment variables for backend/environment/docker-compose.yml
# Copy this file to .env in the same directory before running `docker compose up -d`.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=recruitment_db

# Redis
REDIS_PASSWORD=redis123

# Prometheus
PROMETHEUS_RETENTION_TIME=15d

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Slack alerting (Alertmanager & Grafana)
# Incoming Webhook URL from Slack App > Features > Incoming Webhooks.
# Leave empty to boot Alertmanager with alerts disabled locally.
SLACK_WEBHOOK_URL=
# Optional Bot User OAuth Token from Slack App > Features > OAuth & Permissions
# SLACK_BOT_TOKEN=
# Target Slack channel to receive alerts (e.g. #alerts)
SLACK_CHANNEL=#alerts
SLACK_USERNAME=TalentPulse Alerts

# Optional Ollama profile resource limits
OLLAMA_MEMORY_LIMIT=4g
OLLAMA_MEMORY_SWAP_LIMIT=6g
