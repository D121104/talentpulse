# Server
PORT=8000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=recruitment_db
# Set to false in production and use TypeORM migrations instead.
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=your_access_token_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_ENABLED=true
REDIS_TLS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Cloudinary
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# Email (Gmail SMTP)
EMAIL_AUTH_USER=your_email@gmail.com
EMAIL_AUTH_PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com

# Google OAuth
# Add this exact URL to Google Cloud Console > Authorized redirect URIs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# PayOS Payment Gateway (https://payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_URL=https://api-merchant.payos.vn
PAYMENT_ORDER_TTL_SECONDS=900

# Frontend and CORS
# Must match the Vite development server origin exactly.
URL_FRONTEND=http://localhost:5173

# Authentication cookies
# Development on HTTP localhost: false / lax.
# Production on HTTPS: true / none when frontend and API are cross-site.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave empty for localhost. Set only when a shared parent domain is required.
COOKIE_DOMAIN=

# Background queues and scheduled jobs
# Set false for the Lambda HTTP API; run workers separately.
RUN_BACKGROUND_JOBS=false
# Index dispatcher is a separate opt-in worker. The outbox table is currently
# unscoped, so staging/production workers must use a database dedicated to the
# same declared environment and set both variables to the same value.
RUN_INDEXING_WORKER=false
AI_INDEX_ENVIRONMENT=local
AI_INDEX_OUTBOX_ENVIRONMENT=local
AI_INDEX_WORKER_ID=backend-index-worker
AI_INDEX_BATCH_SIZE=10
AI_INDEX_LEASE_MS=30000
AI_INDEX_POLL_INTERVAL_MS=5000
AI_INDEX_COMPANY_JOB_LIMIT=500

USE_NEURAL_EMBEDDINGS=false
RECOMMENDATION_MIN_SCORE=0.2
RECOMMENDATION_JOBS_PER_EMAIL=6
RECOMMENDATION_EMAIL_INTERVAL_DAYS=7
RECOMMENDATION_MAX_JOBS_PER_COMPANY=2

# Phase 1 local AI foundation
AI_CHAT_ENABLED=true
# Host-run NestJS reaches the Compose-published AI service on port 8001.
# Container-to-container callers must use http://ai-service:8000 instead.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_DAILY_QUOTA=10
AI_CHAT_RETENTION_DAYS=90

# AI CV consent policy. The scope is fixed in backend code; only the active
# policy version/hash can be configured. Leave the hash empty to use the
# built-in Phase 0 policy hash.
AI_CV_CONSENT_VERSION=phase0-v1
AI_CV_CONSENT_POLICY_HASH=
# AI client transport (optional; no dependency is contacted during NestJS boot).
AI_SERVICE_TIMEOUT_MS=15000
AI_SERVICE_CIRCUIT_FAILURE_THRESHOLD=3
AI_SERVICE_CIRCUIT_RESET_MS=30000
AI_SERVICE_ISSUER=talentpulse-api
AI_SERVICE_AUDIENCE=talentpulse-ai
AI_SERVICE_JWT_ALGORITHM=RS256
AI_SERVICE_JWT_TTL_SECONDS=60
AI_SERVICE_JWT_KID=dev-key-1
# Set exactly one key source locally through ignored .env/.env.local.
# When Nest runs from backend/, use the repository-root key path below.
AI_SERVICE_JWT_PRIVATE_KEY_FILE=../.secrets/ai-service-dev-private.pem
# Never put the private key itself in this file or in Compose.
